# Copy to .env and fill in. .env is gitignored.
#
# ./run.sh writes this file for you on first run if it is missing, pointing at
# the private PostgreSQL cluster it manages. If the file already exists it is
# never overwritten, and its DB_ settings decide which database is used.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=trading_sim
DB_USER=admin
DB_PASSWORD=

# Paper-trading keys from alpaca.markets. These stay on the server; the browser
# never receives them. Without them the app still runs, trading against seeded
# placeholder prices, but there are no live quotes and no chart.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Market data host.
ALPACA_BASE_URL=https://data.alpaca.markets

# Optional. The market clock lives on Alpaca's trading host, not the data host.
# Defaults to this value, so you only need the line to override it.
#ALPACA_TRADING_URL=https://api.alpaca.markets

# Virtual cash each new account starts with, and the baseline every P&L figure
# is measured against.
STARTING_BALANCE=100000.00

# Optional. Pooled Postgres connections, 1-64. Defaults to 8.
DB_POOL_SIZE=8
